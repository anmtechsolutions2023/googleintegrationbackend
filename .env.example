# .env.example
# Copy this file to .env and fill in your values.

# --- Application Security ---
# Secret used to sign JWTs. Keep this secure in production.
JWT_SECRET=your_jwt_secret

# --- Server Config ---
# Port the app listens on (default: 5000)
PORT=5000
# Environment name. `production` is what makes the WhatsApp config check FATAL
# at boot (server.js) instead of a logged warning, and it disables the
# development skip on the auth rate limiter. Hosts such as Vercel set this
# themselves — do not add it there by hand.
NODE_ENV=development

# --- MySQL Credentials ---
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# Port the database listens on. Omit for a stock local MySQL (defaults to 3306).
# Managed providers such as Aiven assign a per-service port — copy it from the
# provider's connection details, or every connection times out against 3306.
DB_PORT=3306
# PEM contents of the provider's CA certificate — the certificate itself, not a
# path to it. Required by managed providers that enforce TLS and sign with their
# own CA (Aiven does both). Leave unset for a plaintext local MySQL: TLS is only
# enabled when this is present.
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# =============================================================================
# WhatsApp Cloud API — REQUIRED
# =============================================================================
# Sign-in is WhatsApp one-time codes and nothing else. Without these NOBODY can
# sign in: in production the server refuses to start rather than failing on the
# first person to open the till. `npm run admin:token` is the way back in.
#
# Where each value comes from:
#   PHONE_NUMBER_ID / BUSINESS_ACCOUNT_ID
#       developers.facebook.com → your app → WhatsApp → API Setup
#   ACCESS_TOKEN
#       business.facebook.com → Business Settings → Users → System Users →
#       Generate New Token, with whatsapp_business_messaging and
#       whatsapp_business_management. Shown ONCE. Does not expire, which makes
#       it worth more than a password.
#   APP_SECRET
#       developers.facebook.com → your app → App Settings → Basic
#   WEBHOOK_VERIFY_TOKEN
#       Yours to invent. Any random string; paste the SAME one into Meta's
#       webhook configuration.

# Pinned, not floating: Meta deprecates Graph versions on a published clock.
WA_GRAPH_VERSION=v21.0
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_WEBHOOK_VERIFY_TOKEN=

# Must match the approved template EXACTLY. 'en' is not 'en_US', and the
# mismatch surfaces as Meta error 132001 rather than anything readable.
WA_TEMPLATE_OTP_NAME=login_otp
WA_TEMPLATE_OTP_LANG=en_US

# How long to wait on Meta's Graph API before abandoning a send. A code the
# caller has already given up on is worse than a slow one, so this is short.
WA_SEND_TIMEOUT_MS=10000

# ── LOCAL DEVELOPMENT ONLY — never set this on a deployed environment ────────
# Redirects WhatsApp calls at a stand-in Graph API so sign-in works offline and
# without spending money: `npm run mock:graph`, then uncomment the line below.
# The code prints in the mock's terminal instead of being sent.
#
# config.js IGNORES this whenever NODE_ENV=production, so a copied .env cannot
# redirect the channel that carries every login code. Left commented here so it
# is never inherited by accident.
# WA_GRAPH_BASE_URL=http://localhost:4000

# =============================================================================
# One-time codes
# =============================================================================
# Server-side secret mixed into the code hash. No default on purpose: a shared
# default would mean every deployment that forgot to set it uses one secret.
# Generate with:  openssl rand -hex 32
OTP_PEPPER=


# =============================================================================
# RATE LIMITS  —  all of them, in one block
# Read by src/config/rateLimits.js, which is the ONLY place these are consumed.
# Every value accepts an explicit 0, so a limit can genuinely be disabled.
# =============================================================================

# ── HTTP guard on /api/auth/* (express-rate-limit) ───────────────────────────
# In memory, per instance, reset by every deploy. A guard on an endpoint — NOT
# the spend control. Counts every request, including ones that send nothing.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT=30
# Skipped in development because all local requests share one loopback IP.
# Set false on a staging box that should behave like production.
AUTH_RATE_LIMIT_SKIP_DEV=true

# ── Asking for a code (counted in auth_otp_challenge) ────────────────────────
# Survives restarts, holds across instances, applies in EVERY environment.
# The window both counters below are measured over.
OTP_WINDOW_SECONDS=900
# Counts only messages actually SENT. A request for an unregistered number
# sends nothing and costs nothing, so it must not consume the number's budget.
OTP_MAX_PER_PHONE=3
# Counts EVERY request. This is what bounds abuse of the unknown-number path.
OTP_MAX_PER_IP=10
# Also counts only real sends — there is nothing to wait for after a message
# that never left.
OTP_RESEND_COOLDOWN_SECONDS=60

# ── Spending a code ──────────────────────────────────────────────────────────
# Six digits against five attempts is a 1-in-200,000 guess.
OTP_MAX_ATTEMPTS=5
# Keep in step with the expiry line printed inside the WhatsApp template, or
# the message tells the user something untrue.
OTP_TTL_SECONDS=300

# ── Money ────────────────────────────────────────────────────────────────────
# The cost circuit breaker. Unlike the HTTP limiter this is NOT skipped in
# development: a runaway local test sends real messages and spends real money.
# When it trips, WhatsApp sign-in stops platform-wide and logs at ERROR.
OTP_DAILY_SEND_CAP=500

# =============================================================================
# Onboarding
# =============================================================================
# The reference tenant whose standard role catalogue is cloned into every
# auto-created tenant. The code falls back to the seeded ANM Tech tenant, so
# this is only needed where the database seeded a different UUID.
# ONBOARDING_TEMPLATE_TENANT_ID=e3845e08-dcc2-11f0-8e78-0242ac110002

# --- Connection pool (per serverless INSTANCE, not per deployment) ---
# Vercel FREEZES an instance between requests: the event loop stops, so mysql2's
# idle sweeper never fires and DB_IDLE_TIMEOUT_MS never trims anything. Whatever
# an instance opened, it keeps until the instance is destroyed or the server's
# wait_timeout reaps it. Total connections are therefore
#   warm instances x DB_CONNECTION_LIMIT
# against Aiven's max_connections (46 on the small plans). At 4, eleven warm
# instances exhaust it. At 1, forty-four can be warm before it is even close.
#
# 1 IS SAFE ONLY BECAUSE ONE REQUEST COSTS ONE CONNECTION, and only while Vercel
# runs one request per instance. Two consequences worth knowing before changing
# either:
#
#   * A request that takes a SECOND connection while holding its first cannot
#     complete at 1 — it waits for a connection it is itself holding, and mysql2
#     has no acquire timeout, so it hangs forever and wedges the pool for every
#     later request. src/__tests__/common/oneConnectionPerRequest.test.js fails
#     the build on that shape; do not lower this below 2 without it passing.
#   * ENABLING FLUID COMPUTE means one instance serves many concurrent requests,
#     and 1 then serialises all of them behind a single connection. Fluid and
#     this value must be changed together — raise it to roughly the per-instance
#     concurrency, and re-check warm instances x limit against max_connections.
DB_CONNECTION_LIMIT=1
DB_MAX_IDLE=1
DB_IDLE_TIMEOUT_MS=30000
DB_QUEUE_LIMIT=20

# --- Logging ---
# Controls Winston log level. Common values:
#   error, warn, info, http, verbose, debug, silly
# Use a higher level in production to reduce noise (e.g. warn)
LOG_LEVEL=info
