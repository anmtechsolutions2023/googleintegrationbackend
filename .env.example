# .env.example
# Copy this file to .env and fill in your values

# --- Google Credentials ---
# Your OAuth client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your_google_client_id

# --- Application Security ---
# Secret used to sign JWTs. Keep this secure in production.
JWT_SECRET=your_jwt_secret

# --- Server Config ---
# Port the app listens on (default: 5000)
PORT=5000

# --- MySQL Credentials ---
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
# Port the database listens on. Omit for a stock local MySQL (defaults to 3306).
# Managed providers such as Aiven assign a per-service port — copy it from the
# provider's connection details, or every connection times out against 3306.
DB_PORT=3306
# PEM contents of the provider's CA certificate — the certificate itself, not a
# path to it. Required by managed providers that enforce TLS and sign with their
# own CA (Aiven does both). Leave unset for a plaintext local MySQL: TLS is only
# enabled when this is present.
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# --- Logging ---
# Controls Winston log level. Common values:
#   error, warn, info, http, verbose, debug, silly
# Use a higher level in production to reduce noise (e.g. warn)
LOG_LEVEL=info