        {
          "name": "Create UOM",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.success && jsonData.data && jsonData.data.Id) {",
                  "        pm.collectionVariables.set('uom_id', jsonData.data.Id);",
                  "        console.log('✅ UOM ID saved:', jsonData.data.Id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
