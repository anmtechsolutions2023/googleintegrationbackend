            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/uom?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "uom"],
              "query": [
                {
                  "key": "page",
