          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{app_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"UnitName\": \"Kilogram\",\n    \"IsPrimary\": true,\n    \"Active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/uom",
              "host": ["{{base_url}}"],
              "path": ["api", "uom"]
            },
            "description": "Create a new unit of measure. Requires TENANT_ADMIN or TENANT_SUPER_ADMIN scope. UnitName is required (max 100 chars), IsPrimary defaults to false, Active defaults to true."
          }
        },
        {
          "name": "Update UOM",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{app_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"UnitName\": \"Gram\",\n    \"IsPrimary\": false,\n    \"Active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/uom/{{uom_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "uom", "{{uom_id}}"]
            },
            "description": "Update an existing unit of measure. Requires TENANT_ADMIN or TENANT_SUPER_ADMIN scope. At least one field must be provided."
          }
        },
        {
          "name": "Delete UOM",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{app_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/uom/{{uom_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "uom", "{{uom_id}}"]
            },
            "description": "Delete a unit of measure by ID. Requires TENANT_ADMIN or TENANT_SUPER_ADMIN scope."
          }
        }
      ]
    },
    {
      "name": "User Module",
      "item": [
        {
          "name": "Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{app_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/user/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "user", "logout"]
            },
            "description": "Logout user (client should remove JWT)"
          }
        }
      ]
    }
  ]
}
