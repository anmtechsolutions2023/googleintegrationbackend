-- Table to manage tenant memberships and administrative roles for users.
CREATE TABLE user_tenants (
    tenant_id CHAR(36) NOT NULL COMMENT 'Unique identifier for the tenant (GUID)',
    user_email VARCHAR(100) NOT NULL COMMENT 'Email address of the user',
    is_admin BOOLEAN NOT NULL DEFAULT FALSE COMMENT 'TRUE if the user is an admin for this specific tenant, FALSE otherwise',
    is_active BOOLEAN NOT NULL DEFAULT TRUE COMMENT 'Indicates if the user-tenant association is active',

    -- PRIMARY KEY enforces the uniqueness constraint:
    -- 1. unique (tenant_id, user_email, is_admin)
    -- This key ensures no duplicate entry for the same user/tenant/admin status.
    -- (tenant_id, user_email) could be an alternative PK if (is_admin) was excluded.
    -- The provided feature is "unique tenant_id + email + isAdmin"
    PRIMARY KEY (tenant_id, user_email, is_admin),
    
    -- An index on user_email for efficient lookups of all tenants for a given user.
    INDEX idx_user_email (user_email)
);

-- Table defining available features and their access scopes (read, write, etc.).
CREATE TABLE features (
    feature_id CHAR(36) PRIMARY KEY NOT NULL COMMENT 'Unique identifier for the feature/scope combination (GUID)',
    feature_name VARCHAR(100) NOT NULL COMMENT 'Full descriptive name of the feature',
    feature_short_name VARCHAR(50) NOT NULL COMMENT 'Short, programmatic name of the feature (e.g., reports, billing)',
    scope ENUM('READ', 'WRITE', 'UPDATE') NOT NULL COMMENT 'Access scope for the feature',
    is_active BOOLEAN NOT NULL DEFAULT TRUE COMMENT 'Indicates if this feature/scope is currently enabled',

    -- UNIQUE constraint to enforce: feature_name, scope should be unique.
    -- Optimized: using feature_short_name instead of feature_name as short names are better for lookups.
    UNIQUE KEY uk_feature_scope (feature_short_name, scope)
);

-- Table mapping which features are available to a specific tenant.
CREATE TABLE tenant_features (
    tenant_feature_id CHAR(36) PRIMARY KEY NOT NULL COMMENT 'Unique identifier for this feature-tenant mapping (GUID)',
    tenant_id CHAR(36) NOT NULL COMMENT 'The tenant ID from user_tenants table',
    feature_id CHAR(36) NOT NULL COMMENT 'The feature ID from the features table',
    is_active BOOLEAN NOT NULL DEFAULT TRUE COMMENT 'Indicates if this feature is enabled for this tenant',

    -- UNIQUE constraint to enforce: Tenant_id and feature_id should be unique.
    UNIQUE KEY uk_tenant_feature (tenant_id, feature_id),

    -- Foreign Key constraints for data integrity
    -- Assuming a theoretical 'tenants' table exists (Tenant ID is the actual entity)
    -- We will link it to user_tenants for practical use
    
    -- NOTE: In a real-world scenario, you would have a separate `tenants` table 
    -- with (tenant_id PK) to link to. Since we only have `user_tenants`, 
    -- we'll skip the FK for tenant_id for now as it's not a true PK in `user_tenants`.
    
    -- Linking to the features table
    FOREIGN KEY (feature_id) 
        REFERENCES features(feature_id) 
        ON DELETE RESTRICT ON UPDATE CASCADE
);


