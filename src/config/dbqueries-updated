CREATE TABLE audit_logs (
    log_id INT AUTO_INCREMENT PRIMARY KEY,
    tenant_id CHAR(36),
    user_email VARCHAR(100),
    action VARCHAR(100), -- e.g., 'ACCESS_REPORTS'
    status VARCHAR(20), -- 'SUCCESS' or 'DENIED'
    timestamp DATETIME DEFAULT CURRENT_TIMESTAMP
);
